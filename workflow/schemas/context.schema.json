{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standards selected context preview 0.1.0",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "planSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 },
    "content": { "type": "string", "minLength": 1, "maxLength": 500000, "pattern": "\\S" },
    "manifest": {
      "type": "object",
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 500000 },
        "characters": { "type": "integer", "minimum": 1, "maximum": 500000 },
        "tokens": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 1000000 }, { "type": "null" }] },
        "tokenizer": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" }, { "type": "null" }] },
        "tokenNote": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "inputs": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 },
              "selection": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
            },
            "required": ["path", "sha256", "selection"], "additionalProperties": false
          }
        },
        "omitted": { "type": "array", "minItems": 1, "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" } }
      },
      "required": ["sha256", "bytes", "characters", "tokens", "tokenizer", "tokenNote", "inputs", "omitted"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "planSha256", "content", "manifest"],
  "additionalProperties": false
}
