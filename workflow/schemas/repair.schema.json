{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standards bounded repair decision preview 0.1.0",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "action": { "enum": ["complete", "collect_evidence", "repair", "stop"] },
    "report": { "type": "object" },
    "record": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "planSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 },
        "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 },
        "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 },
        "parentRecordSha256": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 }, { "type": "null" }] },
        "turn": { "type": "integer", "minimum": 0, "maximum": 2 },
        "recordSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 }
      },
      "required": ["schemaVersion", "planSha256", "artifactSha256", "reportSha256", "parentRecordSha256", "turn", "recordSha256"],
      "additionalProperties": false
    },
    "remainingRepairs": { "type": "integer", "minimum": 0, "maximum": 2 },
    "instructions": { "type": "array", "minItems": 0, "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" } }
  },
  "required": ["schemaVersion", "action", "report", "record", "remainingRepairs", "instructions"],
  "additionalProperties": false
}
