# Instrument — matplotlib style. Technical modernism.
figure.facecolor: FFFFFF
axes.facecolor: FFFFFF
axes.edgecolor: 111111
axes.linewidth: 1.5
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
grid.color: D8D8D8
grid.linewidth: 1.0
# All data marks are neutral. Use direct labels and line/marker patterns for
# additional series; a selected datum may have one red rule by a neutral label.
axes.prop_cycle: cycler('color', ['111111', '6B6B6B'])
font.family: sans-serif
font.sans-serif: Public Sans, DejaVu Sans
font.size: 11
axes.labelcolor: 6B6B6B
axes.labelsize: 10
xtick.color: 6B6B6B
ytick.color: 6B6B6B
xtick.labelsize: 10
ytick.labelsize: 10
legend.frameon: False
lines.linewidth: 2.0
lines.solid_capstyle: butt
savefig.facecolor: FFFFFF
savefig.dpi: 200
