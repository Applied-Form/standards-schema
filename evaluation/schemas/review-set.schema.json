{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/evaluation/review-set.schema.json",
  "title": "Standards protocol 0.5 sealed review set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "studyId",
    "declarationSha256",
    "attemptPolicy",
    "cardSetSha256",
    "reviewers",
    "cards",
    "agreementStatistic",
    "agreement",
    "agreementThreshold",
    "agreementGatePassed",
    "conditionScores",
    "artifactScores",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.5.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "studyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"
    },
    "declarationSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attemptPolicy": {
      "const": "first-pass-for-H1"
    },
    "cardSetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewerId",
          "fileSha256"
        ],
        "properties": {
          "reviewerId": {
            "type": "string",
            "minLength": 1
          },
          "fileSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "cards": {
      "type": "integer",
      "minimum": 1
    },
    "agreementStatistic": {
      "const": "krippendorff-alpha-ordinal"
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualHierarchy",
        "systemFidelity",
        "legibility",
        "rhetoricalFit",
        "overall"
      ],
      "properties": {
        "visualHierarchy": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "systemFidelity": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "legibility": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "rhetoricalFit": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "overall": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "agreementThreshold": {
      "const": 0.67
    },
    "agreementGatePassed": {
      "type": "boolean"
    },
    "conditionScores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "requestedModel",
          "ratings",
          "meanScores"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "requestedModel": {
            "type": "string",
            "minLength": 1
          },
          "ratings": {
            "type": "integer",
            "minimum": 1
          },
          "meanScores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "visualHierarchy",
              "systemFidelity",
              "legibility",
              "rhetoricalFit",
              "overall"
            ],
            "properties": {
              "visualHierarchy": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "systemFidelity": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "legibility": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "rhetoricalFit": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "overall": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        }
      }
    },
    "artifactScores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trialId",
          "condition",
          "requestedModel",
          "caseId",
          "repetition",
          "missingArtifact",
          "meanScores"
        ],
        "properties": {
          "trialId": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "requestedModel": {
            "type": "string",
            "minLength": 1
          },
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "repetition": {
            "type": "integer",
            "minimum": 0,
            "maximum": 49
          },
          "missingArtifact": {
            "type": "boolean"
          },
          "meanScores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "visualHierarchy",
              "systemFidelity",
              "legibility",
              "rhetoricalFit",
              "overall"
            ],
            "properties": {
              "visualHierarchy": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "systemFidelity": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "legibility": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "rhetoricalFit": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "overall": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        }
      }
    },
    "status": {
      "const": "sealed"
    }
  }
}
