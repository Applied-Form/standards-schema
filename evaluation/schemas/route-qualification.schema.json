{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/evaluation/route-qualification.schema.json",
  "title": "Standards protocol 0.5 route qualification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "routeId",
    "qualifiedAt",
    "expiresAt",
    "receiptSha256",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.5.0"
    },
    "routeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"
    },
    "qualifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "timeBlocks",
        "successes",
        "successRate",
        "acceptedIdentities",
        "acceptedIdentityRate",
        "textOutputs",
        "textOutput",
        "providerPinMatches",
        "providerPinned",
        "parameterAcceptances",
        "parametersAccepted",
        "reservationIds"
      ],
      "properties": {
        "calls": {
          "const": 10
        },
        "timeBlocks": {
          "const": 2
        },
        "successes": {
          "type": "integer",
          "minimum": 9,
          "maximum": 10
        },
        "successRate": {
          "type": "number",
          "minimum": 0.9,
          "maximum": 1
        },
        "acceptedIdentities": {
          "const": 10
        },
        "acceptedIdentityRate": {
          "const": 1
        },
        "textOutputs": {
          "type": "integer",
          "minimum": 9,
          "maximum": 10
        },
        "textOutput": {
          "const": true
        },
        "providerPinMatches": {
          "const": 10
        },
        "providerPinned": {
          "const": true
        },
        "parameterAcceptances": {
          "const": 10
        },
        "parametersAccepted": {
          "const": true
        },
        "reservationIds": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"
          }
        }
      }
    }
  }
}
