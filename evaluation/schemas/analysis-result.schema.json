{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/evaluation/analysis-result.schema.json",
  "title": "Standards protocol 0.5 confirmatory analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "studyId",
    "runId",
    "declarationSha256",
    "status",
    "primary",
    "secondary",
    "h2",
    "reviewStatus",
    "claimGatePassed",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.5.0"
    },
    "studyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "declarationSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "complete",
        "mechanical-analysis-complete"
      ]
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment",
        "comparator",
        "outcome",
        "pairs",
        "estimate",
        "confidenceInterval",
        "oneSided95Lower",
        "bootstrap",
        "oneSidedPValueAtZero",
        "strata",
        "minimumEffect",
        "gatePassed"
      ],
      "properties": {
        "treatment": {
          "type": "string",
          "minLength": 1
        },
        "comparator": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "pairs": {
          "type": "integer",
          "minimum": 1
        },
        "estimate": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "confidenceInterval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "lower",
            "upper"
          ],
          "properties": {
            "level": {
              "const": 0.95
            },
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            }
          }
        },
        "oneSided95Lower": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "replicates",
            "seed"
          ],
          "properties": {
            "method": {
              "const": "paired-stratified-model-case-v1"
            },
            "replicates": {
              "const": 20000
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "oneSidedPValueAtZero": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "strata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "models",
            "families"
          ],
          "properties": {
            "models": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "modelId",
                  "modelFamily",
                  "pairs",
                  "estimate"
                ],
                "properties": {
                  "modelId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "modelFamily": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pairs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "estimate": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                }
              }
            },
            "families": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "modelFamily",
                  "pairs",
                  "estimate"
                ],
                "properties": {
                  "modelFamily": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pairs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "estimate": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "minimumEffect": {
          "const": 0.1
        },
        "gatePassed": {
          "type": "boolean"
        }
      }
    },
    "secondary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "treatment",
          "comparator",
          "outcome",
          "pairs",
          "estimate",
          "confidenceInterval",
          "oneSided95Lower",
          "bootstrap",
          "oneSidedPValueAtZero",
          "strata",
          "holmAdjustedPValue",
          "holmSignificant"
        ],
        "properties": {
          "treatment": {
            "type": "string",
            "minLength": 1
          },
          "comparator": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "pairs": {
            "type": "integer",
            "minimum": 1
          },
          "estimate": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "confidenceInterval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "lower",
              "upper"
            ],
            "properties": {
              "level": {
                "const": 0.95
              },
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              }
            }
          },
          "oneSided95Lower": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "bootstrap": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "replicates",
              "seed"
            ],
            "properties": {
              "method": {
                "const": "paired-stratified-model-case-v1"
              },
              "replicates": {
                "const": 20000
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "oneSidedPValueAtZero": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "strata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "models",
              "families"
            ],
            "properties": {
              "models": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "modelId",
                    "modelFamily",
                    "pairs",
                    "estimate"
                  ],
                  "properties": {
                    "modelId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "modelFamily": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pairs": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "estimate": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    }
                  }
                }
              },
              "families": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "modelFamily",
                    "pairs",
                    "estimate"
                  ],
                  "properties": {
                    "modelFamily": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pairs": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "estimate": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          },
          "holmAdjustedPValue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "holmSignificant": {
            "type": "boolean"
          }
        }
      }
    },
    "h2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenEfficiency",
        "nonInferiority",
        "mechanicalGatePassed",
        "fullGatePassed"
      ],
      "properties": {
        "tokenEfficiency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "pairs",
            "meanDifference",
            "meanRatio",
            "maximumRatio",
            "gatePassed"
          ],
          "properties": {
            "outcome": {
              "const": "firstCallPromptTokens"
            },
            "pairs": {
              "type": "integer",
              "minimum": 1
            },
            "meanDifference": {
              "type": "number"
            },
            "meanRatio": {
              "type": "number",
              "minimum": 0
            },
            "maximumRatio": {
              "const": 0.8
            },
            "gatePassed": {
              "type": "boolean"
            }
          }
        },
        "nonInferiority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "briefFulfilment",
            "agentContractConformance",
            "sourceFactCoverage",
            "designerOverall"
          ],
          "properties": {
            "briefFulfilment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "estimate",
                "confidenceInterval",
                "oneSided95Lower",
                "margin",
                "passed"
              ],
              "properties": {
                "estimate": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "confidenceInterval": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "level",
                    "lower",
                    "upper"
                  ],
                  "properties": {
                    "level": {
                      "const": 0.95
                    },
                    "lower": {
                      "type": "number"
                    },
                    "upper": {
                      "type": "number"
                    }
                  }
                },
                "oneSided95Lower": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "margin": {
                  "type": "number",
                  "minimum": 0
                },
                "passed": {
                  "type": "boolean"
                }
              }
            },
            "agentContractConformance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "estimate",
                "confidenceInterval",
                "oneSided95Lower",
                "margin",
                "passed"
              ],
              "properties": {
                "estimate": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "confidenceInterval": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "level",
                    "lower",
                    "upper"
                  ],
                  "properties": {
                    "level": {
                      "const": 0.95
                    },
                    "lower": {
                      "type": "number"
                    },
                    "upper": {
                      "type": "number"
                    }
                  }
                },
                "oneSided95Lower": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "margin": {
                  "type": "number",
                  "minimum": 0
                },
                "passed": {
                  "type": "boolean"
                }
              }
            },
            "sourceFactCoverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "estimate",
                "confidenceInterval",
                "oneSided95Lower",
                "margin",
                "passed"
              ],
              "properties": {
                "estimate": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "confidenceInterval": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "level",
                    "lower",
                    "upper"
                  ],
                  "properties": {
                    "level": {
                      "const": 0.95
                    },
                    "lower": {
                      "type": "number"
                    },
                    "upper": {
                      "type": "number"
                    }
                  }
                },
                "oneSided95Lower": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "margin": {
                  "type": "number",
                  "minimum": 0
                },
                "passed": {
                  "type": "boolean"
                }
              }
            },
            "designerOverall": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "estimate",
                    "confidenceInterval",
                    "oneSided95Lower",
                    "margin",
                    "passed",
                    "method"
                  ],
                  "properties": {
                    "estimate": {
                      "type": "number",
                      "minimum": -4,
                      "maximum": 4
                    },
                    "confidenceInterval": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "level",
                        "lower",
                        "upper"
                      ],
                      "properties": {
                        "level": {
                          "const": 0.95
                        },
                        "lower": {
                          "type": "number"
                        },
                        "upper": {
                          "type": "number"
                        }
                      }
                    },
                    "oneSided95Lower": {
                      "type": "number",
                      "minimum": -4,
                      "maximum": 4
                    },
                    "margin": {
                      "const": 0.25
                    },
                    "passed": {
                      "type": "boolean"
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "mechanicalGatePassed": {
          "type": "boolean"
        },
        "fullGatePassed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "reviewStatus": {
      "enum": [
        "passed",
        "not-sealed",
        "agreement-below-threshold"
      ]
    },
    "claimGatePassed": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
