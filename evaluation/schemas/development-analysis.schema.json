{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/evaluation/development-analysis.schema.json",
  "title": "Standards protocol 0.5 development analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "runId", "planSha256", "runResultsSha256",
               "status", "claims", "matrix", "observedPowerInputs", "h1",
               "confirmatoryPowerPlan", "blockers", "limitations"],
  "properties": {
    "schemaVersion": {"const": "0.5.0"},
    "planId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"},
    "runId": {"type": "string", "minLength": 1},
    "planSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runResultsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["power-plan-ready", "power-plan-blocked"]},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "interpretation"],
      "properties": {
        "status": {"const": "disabled"},
        "interpretation": {"const": "development-estimation-only"}
      }
    },
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedCells", "retainedTrials", "failedTrials"],
      "properties": {
        "expectedCells": {"type": "integer", "minimum": 1},
        "retainedTrials": {"type": "integer", "minimum": 1},
        "failedTrials": {"type": "integer", "minimum": 0}
      }
    },
    "observedPowerInputs": {
      "type": "object", "additionalProperties": false,
      "required": ["baselineRate", "treatmentRate", "effect", "withinPairCorrelation", "pairs"],
      "properties": {
        "baselineRate": {"type": "number", "minimum": 0, "maximum": 1},
        "treatmentRate": {"type": "number", "minimum": 0, "maximum": 1},
        "effect": {"type": "number", "minimum": -1, "maximum": 1},
        "withinPairCorrelation": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "pairs": {"type": "integer", "minimum": 1}
      }
    },
    "h1": {"type": "object"},
    "confirmatoryPowerPlan": {"type": ["object", "null"]},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
